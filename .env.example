# Copie para .env e ajuste. O .env NUNCA vai para o git.

# --- API de origem (SEED) ---
API_BASE_URL=https://api.example.com
API_EMAIL=your_email@example.com
API_PASSWORD=your_password
# true = gera dados sintéticos (Faker) em vez de chamar a API real
USE_SYNTHETIC_DATA=true

# --- Data lake (S3 compatível) ---
# Local: SeaweedFS. Na AWS: remover S3_ENDPOINT_URL e usar credenciais IAM.
# As mesmas chaves criam o usuário no SeaweedFS e são lidas pelo boto3.
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=raw
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=lake_admin
AWS_SECRET_ACCESS_KEY=change_me

# --- Data warehouse (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dw_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dw

# --- Metabase ---
METABASE_PORT=3000
METABASE_DB=metabase
# usuário somente leitura que o Metabase usa para ler o schema marts
METABASE_READER_PASSWORD=change_me
